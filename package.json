{
  "name": "sala13",
  "version": "0.4.0",
  "private": true,
  "description": "A self-hosted real-time multiplayer game room for classrooms and friends.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sala13/server",
    "start": "npm run start --workspace @sala13/server",
    "setup:lan:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/allow-windows-lan.ps1",
    "test": "npm run test --workspaces --if-present",
    "check": "node scripts/check-syntax.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
