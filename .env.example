# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Comma-separated browser origins. Keep empty in development to accept the
# same origin only. Example: https://sala13.example.com,https://pi.tailnet.ts.net
ALLOWED_ORIGINS=

# Room lifecycle
DISCONNECT_GRACE_MS=30000
EMPTY_ROOM_TTL_MS=30000
STALE_ROOM_TTL_MS=21600000

# Socket abuse protection (per socket, rolling fixed window)
SOCKET_RATE_WINDOW_MS=10000
SOCKET_RATE_MAX_EVENTS=80

